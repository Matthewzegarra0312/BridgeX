{
  "name": "agent-reportes",
  "version": "1.0.0",
  "description": "Agente de Reportes - MCP para consultas MySQL y envío de reportes por Gmail",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "postbuild": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mysql",
    "gmail",
    "reports",
    "typescript",
    "agent"
  ],
  "author": "Tu Nombre",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.2",
    "mysql2": "^3.11.4",
    "googleapis": "^144.0.0",
    "express": "^4.21.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "csv-stringify": "^6.5.1",
    "handlebars": "^4.7.8",
    "winston": "^3.15.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "rimraf": "^6.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/agent-reportes.git"
  },
  "bugs": {
    "url": "https://github.com/tu-usuario/agent-reportes/issues"
  },
  "homepage": "https://github.com/tu-usuario/agent-reportes#readme"
