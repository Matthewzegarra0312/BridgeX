# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS MYSQL LOCAL
# =============================================================================

# Configuración de conexión MySQL Local
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reportes_db
DB_USER=root
DB_PASS=

# Configuración de conexión SSL (opcional, por defecto false para local)
DB_SSL=false
DB_CONNECTION_LIMIT=10
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=30000

