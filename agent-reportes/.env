# =============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# =============================================================================

# Puerto y host del servidor backend
PORT=3000
HOST=localhost

# Configuración de logging
LOG_LEVEL=info
NODE_ENV=development

# =============================================================================
# CONFIGURACIÓN DE REPORTES PROGRAMADOS
# =============================================================================

# Habilitar/deshabilitar tareas programadas (cron)
ENABLE_CRON=true

# Programación de reportes automáticos (formato cron)
# "0 9 * * *" = Todos los días a las 9:00 AM
# "0 9 * * 1-5" = Lunes a viernes a las 9:00 AM
# "0 */6 * * *" = Cada 6 horas
CRON_SCHEDULE=0 9 * * *

# Destinatarios por defecto para reportes automáticos (separados por comas)
DEFAULT_RECIPIENTS=

# Tipo de reporte por defecto
DEFAULT_REPORT_TYPE=ventas_diarias

# =============================================================================
# INSTRUCCIONES DE CONFIGURACIÓN
# =============================================================================

# PASO 1: CONFIGURAR MYSQL
# - Asegúrate de tener MySQL instalado y corriendo
# - Actualiza DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASS con tus credenciales
# - Si usas MySQL local, DB_HOST=localhost y DB_PORT=3306 son los valores típicos
# - Crea la base de datos: CREATE DATABASE reportes_db;

# PASO 2: CONFIGURAR GMAIL CON SERVICE ACCOUNT
# - GMAIL_SERVICE_ACCOUNT_EMAIL: Email de la cuenta de servicio (ya configurado)
# - GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY: Clave privada (ya configurada)
# - GMAIL_IMPERSONATE_EMAIL: Email de la persona a impersonar (EDITAR)
#   * Este debe ser un email de tu dominio de Google Workspace
#   * El service account debe tener permisos para impersonarlo
#   * Ejemplo: tu_email@tuempresa.com

# PASO 3: INICIAR EL BACKEND
# - Ejecuta: npm install
# - Ejecuta: npm start
# - El servidor estará disponible en http://localhost:3000

# PASO 4: VERIFICAR
# - Abre http://localhost:3000/health en tu navegador
# - Deberías ver: {"status":"healthy","timestamp":"...","version":"1.0.0"}
