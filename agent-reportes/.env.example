# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS MYSQL
# =============================================================================

# Configuración de conexión MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reportes_db
DB_USER=reportes_user
DB_PASS=tu_password_mysql

# Configuración de conexión SSL (opcional)
DB_SSL=false
DB_CONNECTION_LIMIT=10
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=30000

# =============================================================================
# CONFIGURACIÓN DE GMAIL CON SERVICE ACCOUNT (OAuth2 - Google Cloud)
# =============================================================================

# Credenciales de Service Account de Google Cloud
# Obtenidas de: Google Cloud Console → Proyecto → Service Accounts → Keys → JSON

GMAIL_SERVICE_ACCOUNT_EMAIL=sundai-latam@sundai-latam.iam.gserviceaccount.com
GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...tu_private_key...\n-----END PRIVATE KEY-----\n
GMAIL_IMPERSONATE_EMAIL=tu_email_corporativo@empresa.com

# =============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# =============================================================================

# Puerto y host del servidor
PORT=3000
HOST=localhost

# Configuración de logging
LOG_LEVEL=info
NODE_ENV=development

# =============================================================================
# CONFIGURACIÓN DE REPORTES PROGRAMADOS
# =============================================================================

# Habilitar/deshabilitar tareas programadas (cron)
ENABLE_CRON=true

# Programación de reportes automáticos (formato cron)
# Ejemplo: "0 9 * * *" = Todos los días a las 9:00 AM
# Ejemplo: "0 9 * * 1-5" = Lunes a viernes a las 9:00 AM
# Ejemplo: "0 */6 * * *" = Cada 6 horas
CRON_SCHEDULE=0 9 * * *

# Destinatarios por defecto para reportes automáticos (separados por comas)
DEFAULT_RECIPIENTS=finanzas@empresa.com,gerencia@empresa.com,analitica@empresa.com

# Tipo de reporte por defecto
DEFAULT_REPORT_TYPE=ventas_diarias

# =============================================================================
# CONFIGURACIÓN DE SEGURIDAD (PRODUCCIÓN)
# =============================================================================

# Configuración de CORS para producción
# CORS_ORIGIN=https://tu-dominio.com,https://otro-dominio.com

# Límite de tamaño de payload JSON
# JSON_LIMIT=10mb

# Configuración de rate limiting
# RATE_LIMIT_WINDOW=15
# RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS DE EJEMPLO
# =============================================================================

# Las siguientes son consultas SQL de ejemplo que puedes usar para crear
# las tablas necesarias para los reportes:

# CREATE DATABASE reportes_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# 
# USE reportes_db;
# 
# CREATE TABLE clientes (
#   id INT PRIMARY KEY AUTO_INCREMENT,
#   nombre VARCHAR(255) NOT NULL,
#   email VARCHAR(255) UNIQUE,
#   telefono VARCHAR(20),
#   created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
# );
#
# CREATE TABLE productos (
#   id INT PRIMARY KEY AUTO_INCREMENT,
#   nombre VARCHAR(255) NOT NULL,
#   precio DECIMAL(10,2) NOT NULL,
#   categoria VARCHAR(100),
#   created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
# );
#
# CREATE TABLE ventas (
#   id INT PRIMARY KEY AUTO_INCREMENT,
#   cliente_id INT,
#   producto_id INT,
#   monto DECIMAL(10,2) NOT NULL,
#   fecha TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
#   FOREIGN KEY (cliente_id) REFERENCES clientes(id),
#   FOREIGN KEY (producto_id) REFERENCES productos(id)
# );

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================

# 1. GMAIL SERVICE ACCOUNT (OAuth2):
#    - Ve a Google Cloud Console (https://console.cloud.google.com/)
#    - Crea un proyecto o selecciona uno existente
#    - Habilita la Gmail API
#    - Crea una "Service Account" en Credenciales
#    - Descarga el archivo JSON
#    - Extrae: serviceAccountEmail, privateKey (con \n), projectId
#    - El email a impersonar debe tener permiso en Google Workspace Admin
#    
#    Configuración en Google Workspace Admin:
#    - Ve a Admin → Controles de aplicaciones → Configuración SMTP/Gmail
#    - Agrega el service account con permisos para enviar como otros usuarios
#    - O configura la delegación de dominio en la service account

# 2. MYSQL SETUP:
#    Asegúrate de tener MySQL instalado y ejecutándose
#    Crea la base de datos y usuario con los permisos necesarios
#    Ejecuta las consultas SQL de ejemplo mostradas arriba

# 3. SEGURIDAD:
#    - Nunca commits este archivo con valores reales
#    - Usa un gestor de secretos en producción
#    - Restringe acceso a la base de datos por IP si es posible
#    - Usa conexiones SSL en producción